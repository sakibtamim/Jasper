{
    "compilerOptions": {
        "target": "ES2022",
        "module": "ESNext",
        "moduleResolution": "Bundler",
        "strict": true,
        "esModuleInterop": true,
        "skipLibCheck": true,
        "forceConsistentCasingInFileNames": true,
        "outDir": "./dist",
        "rootDir": ".",
        "baseUrl": ".",
        "jsx": "react-jsx",
        "resolveJsonModule": true,
        "paths": {
            "@jasper/elements": [
                "./web/elements.tsx"
            ],
            "@jasper/ui": [
                "./web/ui"
            ],
            "@jasper/ui/*": [
                "./web/ui/*"
            ]
        }
    },
    "include": [
        "src/**/*",
        "web/**/*",
        "scripts/**/*",
        "vite.config.ts"
    ],
    "exclude": [
        "node_modules",
        "**/*.spec.ts",
        "src/plugins/**/web"
    ]
}