# =============================================================================
# Jasper Music Bot - Environment Variables
# =============================================================================
# See ENV.md for detailed documentation of all environment variables.
# =============================================================================

# Discord Bot Configuration (Required)
DISCORD_TOKEN=your-bot-token-here
DISCORD_CLIENT_ID=your-application-client-id
GUILD_ID=your-development-guild-id

# Worker Bots (Optional - Add as many as needed)
# MISTY_TOKEN=worker-token-1
# TUKI_TOKEN=worker-token-2
# JAFREEN_TOKEN=worker-token-3

# AFR (Automatic Feline Rotation) Configuration
# AFR_JASPER_WEIGHT=0.5
# Options:
#   0.5 = Balanced (50% Jasper, 50% Workers) - Default
#   1.0 = Jasper Always (Legacy behavior)
#   0.0 = Workers Always (Jasper never joins)
#   0.75 = Jasper Preferred (75% Jasper, 25% Workers)

# Channel ID for startup/shutdown announcements (Optional)
# ANNOUNCE_CHANNEL_ID=your-channel-id-here

# Caching Configuration (Optional)
# CACHE_ENABLED=false                    # Enable/disable caching system (default: false)
# CACHE_SEARCH_TTL_HOURS=168             # Search result cache TTL in hours (default: 7 days)
# CACHE_AUDIO_TTL_HOURS=72               # Audio file cache TTL in hours (default: 3 days)
# CACHE_CLEANUP_INTERVAL_HOURS=1         # Background cleanup interval in hours (default: 1 hour)

# Database Configuration (Optional)
# DB_TYPE=sqlite                          # Database type: sqlite (default) or postgres
# DATABASE_URL=postgresql://user:pass@localhost:5432/jasper_db  # Required if DB_TYPE=postgres

# yt-dlp Configuration (Optional)
# YT_DLP_JS_RUNTIME=node                 # JavaScript runtime for yt-dlp (default: node)
# YT_DLP_PLAYER_CLIENT=default           # YouTube player client (default: default)

# Web Server Configuration (Optional - Required for Web UI)
# PORT=3000                               # Set to enable Web UI

# Authentication Configuration (Required for Web UI)
# DISCORD_CLIENT_SECRET=your-client-secret-here      # Client Secret from Discord Developer Portal
# BASE_URL=http://localhost:3000                     # Public-facing URL of the application
# FRONTEND_URL=http://localhost:5173                 # URL of the frontend (for redirects in dev/prod split)
COOKIE_SECRET=CHANGE_ME_RUN_OPENSSL_RAND_BASE64_32         # Secret key for signing cookies (change in production)
ENCRYPTION_KEY=CHANGE_ME_RUN_OPENSSL_RAND_HEX_32    # Key for encrypting OAuth tokens (32+ characters)
# PBKDF2_ITERATIONS=100000                           # PBKDF2 iterations for key derivation (default: 100000)

# Runtime Configuration
# NODE_ENV=production                     # production or development
