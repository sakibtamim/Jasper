# ==============================================================================
# Jasper Production Docker Compose Environment Configuration
# ==============================================================================

# Discord Bot Credentials (Required)
DISCORD_TOKEN=your-production-bot-token
DISCORD_CLIENT_ID=your-discord-client-id
GUILD_ID=your-primary-guild-id

# Web Dashboard & OAuth2 Configuration (Required if PORT is active)
PORT=3000
DISCORD_CLIENT_SECRET=your-discord-client-secret
COOKIE_SECRET=generate-a-strong-random-cookie-secret-min-32-chars
ENCRYPTION_KEY=generate-a-strong-random-encryption-key-min-32-chars
ANNOUNCE_CHANNEL_ID=

# Optional Worker Bot Tokens (Multi-Client AFR Playback)
# Uncomment profiles in docker compose or run: docker compose --profile workers up -d
MISTY_TOKEN=
TUKI_TOKEN=
JAFREEN_TOKEN=

# PostgreSQL 16 Database Configuration
POSTGRES_USER=jasper
POSTGRES_PASSWORD=generate_a_secure_postgres_password_here
POSTGRES_DB=jasper

# MinIO / S3 Media Storage Configuration
MINIO_ROOT_USER=jasper_admin
MINIO_ROOT_PASSWORD=generate_a_secure_minio_secret_key_here
MINIO_CONSOLE_PORT=9001
S3_BUCKET=jasper-media

# Optional Cache Settings
CACHE_ENABLED=true
